# App Configuration
# Copy this file to .env and fill in your values

# Convex Configuration (required)
# Get these from `npx convex dev` or your Convex dashboard
EXPO_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-project-name.convex.site

# Future API configuration
# API_URL=https://api.example.com

# Resend API for password reset emails (required for password reset)
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_...
# EMAIL_FROM=Trading Journal <onboarding@resend.dev>

# Feature Flags
# ENABLE_ANALYTICS=true
